// Tests for the ntp brick. Run them from the brick's directory:
//   clay tests/test_ntp.clay
//
// (a brick can be imported by its own name from inside its own directory)
import("ntp")

failures = 0
check = { |what, ok|
    ok ifFalse { ("FAIL: " + what) println; failures = failures + 1 }
}

// helpers for test cases that raise: the error's type, and its message
raises = { |block| try { block(); "no error" } catch { |e| e type } }
messageOf = { |block| try { block(); "no error" } catch { |e| e message } }

bytes32 = { |n| 
    String fromBytes([n >> 24 & 0xff, n >> 16 & 0xff, n >> 8 & 0xFF, n & 0xFF])
}

stampOf = { |ms|                       // unix ms -> 8 timestamp bytes
    secs = ms / 1000 + 2208988800
    frac = ((ms % 1000) * 4294967296 + 999) / 1000        // + 999: round UP
    (bytes32(secs % 4294967296)) + (bytes32(frac))
}

// a 48-byte client request: byte 0 = 35, 8 nonce bytes at 40..47
nonce = String fromBytes([1, 2, 3, 4, 5, 6, 7, 8])
request = String fromBytes([35]) + ((String chr(0)) repeat(39)) + nonce

// build a server reply. kiss is 4 chars (used when stratum is 0)
reply = { |b0, stratum, kiss, echo, t2, t3|
    (String fromBytes([b0, stratum])) + ((String chr(0)) repeat(10)) + kiss +
    ((String chr(0)) repeat(8)) + echo + (stampOf(t2)) + (stampOf(t3))
}

// setup known-value cases for helper _toMillis()
secs = [4003520545, 3000000000, 3000000000, 100, 2147483647, 2147483648, 2208988800]
fracs = [266287973, 2147483648, 4294967295, 0, 0, 0, 0 ]
expected = [1794531745062, 791011200500, 791011200999, 2085978596000, 4233462143000, -61505152000, 0]
names = [
    "a real time", 
    "half a second", 
    "maximum fraction", 
    "era 1", 
    "last era-1 second",
    "first era-0 second",
    "the Unix epoch"
]

secs length times { |i| 
    data = bytes32(secs at(i)) + bytes32(fracs at(i))
    check("parse ${names at(i)}", (Ntp _toMillis(data, 0)) == expected at(i))
}

// A reply is [b0, stratum] + 10 zero bytes + 4 bytes at 12–15 (the kiss code, "RATE") + 8 zero bytes + the echo (request slice(40, 48)) + stampOf(t2) + stampOf(t3).
kiss = String chr(0) repeat(4)

t1 = 1794531745000
good = reply(36, 2, kiss, nonce, t1 + 60, t1 + 62)

r = Ntp parse(good, request, t1, t1 + 22)
check("offset", r get("offset") == 50)
check("delay",  r get("delay") == 20)
check("time",   r get("time") == t1 + 62)
check("stratum", r get("stratum") == 2)
check("leap",   r get("leap") == 0)

local_ahead = reply(36, 2, kiss, nonce, t1 - 10, t1 - 8)
r = Ntp parse(local_ahead, request, t1, t1 + 22)
check("offset", r get("offset") == -20)
check("delay", r get("delay") == 20)

r1 = Ntp parse(reply(100, 2, kiss, nonce, t1+60, t1+62), request, t1, t1+22)
check("leap 1 accepted and returned", r1 get("leap") == 1)

r2 = Ntp parse(reply(164, 2, kiss, nonce, t1+60, t1+62), request, t1, t1+22)
check("leap 2 accepted and returned", r2 get("leap") == 2)

r15 = Ntp parse(reply(36, 15, kiss, nonce, t1+60, t1+62), request, t1, t1+22)
check("stratum 15 accepted", r15 get("stratum") == 15)

// test negative parse() cases
rejects = { |what, rep, msg|
    check(what, (messageOf({Ntp parse(rep, request, t1, t1 + 22)})) == msg)
}

msg = { |req, sent, recv| messageOf({Ntp parse(good, req, sent, recv)}) }
check("sentMs nil", (msg(request, nil, t1+22)) == "ntp parse: sentMs must be an integer number of milliseconds")
check("sentMs float", (msg(request, 1.5, t1+22)) == "ntp parse: sentMs must be an integer number of milliseconds")
check("receivedMs string", (msg(request, t1, "x")) == "ntp parse: receivedMs must be an integer number of milliseconds")
check("receivedMs float", (msg(request, t1, 1.5)) == "ntp parse: receivedMs must be an integer number of milliseconds")

// Not a String, or under 48 bytes.
check("short request", (msg(request slice(0, 10), t1, t1+22)) == "ntp parse: request too small")
check("request not a String", (msg(5, t1, t1+22)) == "ntp parse: expects a String (got Number)")

// Not a server reply: byte0 % 8 must be 4.
rejects("client mode", reply(35, 2, kiss, nonce, t1 + 60, t1 + 62), "ntp parse: not a server reply")

// Version ((byte0 / 8) % 8) must be 3 or 4.
rejects("version 2", reply(20, 2, kiss, nonce, t1 + 60, t1 + 62), "ntp parse: incorrect version")
rejects("version 5", reply(44, 2, kiss, nonce, t1 + 60, t1 + 62), "ntp parse: incorrect version")

// The echoed bytes reply slice(24, 32) must equal request slice(40, 48).
rejects("wrong echo", reply(36, 2, kiss, "XXXXXXXX", t1 + 60, t1 + 62), "ntp parse: request/reply mismatch")

// Stratum 0 is a "kiss-o'-death", and its reason is at slice(12, 16) (for example RATE), so put it in the message.
rejects("kiss of death", reply(36, 0, "RATE", nonce, t1 + 60, t1 + 62), "ntp parse: kiss of death RATE")

// Leap (byte0 / 64) of 3 means unsynchronized.
rejects("unsynchronized", reply(228, 2, kiss, nonce, t1 + 60, t1 + 62), "ntp parse: unsynchronized")

// Stratum above 15 is invalid.
rejects("stratum 16", reply(36, 16, kiss, nonce, t1 + 60, t1 + 62), "ntp parse: invalid stratum")

// test request()
r = Ntp request
check("request is 48 bytes", r length == 48)
check("request byte 0 is 35", (r byteAt(0)) == 35)
check("request bytes 1..39 are zero", (r slice(1, 40)) == ((String chr(0)) repeat(39)))
check("two requests differ", (Ntp request) != (Ntp request))
check("nonce is not all zero", (r slice(40, 48)) != ((String chr(0)) repeat(8)))

req = Ntp request
rep = reply(36, 2, kiss, req slice(40, 48), t1 + 60, t1 + 62)
check("a reply to a real request parses", (Ntp parse(rep, req, t1, t1 + 22)) get("offset") == 50)

// test nonce randomness
// every nonce byte is random: each position takes more than one value over 20 requests
seen = []
8 times { |i| seen push([]) }

20 times {
    n = (Ntp request) slice(40, 48)
    8 times { |i| (seen at(i)) push(n byteAt(i)) }
}

8 times { |i|
    values = seen at(i)
    check("nonce byte ${i} varies", values unique size > 1)
}

// test query()
silent = Socket udp(0)
start = Date nowMillis
check("query times out when nobody answers",
    (raises({ Ntp query("127.0.0.1", silent localPort, 200) })) == "TimeoutError")

elapsed = Date nowMillis - start

check("the timeout is about what was asked", elapsed >= 150 && elapsed < 2000)
silent close

check("query accepts just a host",
    (raises({ Ntp query("no.such.host.invalid") })) == "SocketError")

// test bad host
check("query to an unknown host raises SocketError",
    (raises({ Ntp query("no.such.host.invalid", 123, 200) })) == "SocketError")

// see if we passed all tests
(failures > 0) ifTrue {
    (failures toString + " checks failed") println
    System exit(1)
}

"ntp tests passed" println
